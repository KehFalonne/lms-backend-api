# ═════════════════════════════════════════════════════════════════════
# Django core
# ═════════════════════════════════════════════════════════════════════
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production-use-50-plus-random-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend URL — used in emails and reset links
FRONTEND_URL=http://localhost:3000

# ═════════════════════════════════════════════════════════════════════
# Database
# ═════════════════════════════════════════════════════════════════════
DATABASE_URL=postgres://gu_lms:gu_lms_pw@localhost:5432/gu_lms

# ═════════════════════════════════════════════════════════════════════
# Redis (cache + Celery broker + Channels layer)
# ═════════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ═════════════════════════════════════════════════════════════════════
# JWT
# ═════════════════════════════════════════════════════════════════════
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ═════════════════════════════════════════════════════════════════════
# CORS
# ═════════════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ═════════════════════════════════════════════════════════════════════
# Institution
# ═════════════════════════════════════════════════════════════════════
INSTITUTION_NAME=Gracious University
INSTITUTION_CODE=GU
INSTITUTION_TIMEZONE=Africa/Douala

# ═════════════════════════════════════════════════════════════════════
# File storage  (LOCAL | S3 | R2 | MINIO)
# ═════════════════════════════════════════════════════════════════════
STORAGE_PROVIDER=LOCAL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# ═════════════════════════════════════════════════════════════════════
# Email
# ═════════════════════════════════════════════════════════════════════
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@graciousuniversity.edu

# ═════════════════════════════════════════════════════════════════════
# Observability (production only — leave blank in dev)
# ═════════════════════════════════════════════════════════════════════
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1